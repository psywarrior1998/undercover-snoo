{
  "name": "undercover-snoo",
  "version": "0.0.1",
  "description": "Daily 60-second AI imposter deduction game for Reddit Game of the Day Hackathon 2026",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build:client": "vite build",
    "build:server": "esbuild src/server/index.ts --bundle --platform=node --target=node22 --format=cjs --outfile=dist/server/index.cjs",
    "build": "npm run build:client && npm run build:server"
